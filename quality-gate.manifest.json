{
	"$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.16.0/schemas/schema.json",
	"services": [
		{
			"product": "Passport-CRI",
			"component": "ipv-cri-uk-passport-api",
			"promotionType": "securePipelines",
			"automated": [
				{
					"phase": "pre-merge",
					"provider": "GitHub",
					"config": {
						"file": ".github/workflows/check-pr.yml",
						"path": "$.jobs.pre-commit"
					},
					"checks": [
						{
							"name": "code style and linting"
						},
						{
							"name": "secret scanning"
						}
					]
				},
				{
					"phase": "pre-merge",
					"provider": "GitHub",
					"config": {
						"file": ".github/workflows/check-pr.yml",
						"path": "$.jobs.java-build-check"
					},
					"checks": [
						{
							"name": "code style and linting"
						}
					]
				},
				{
					"phase": "pre-merge",
					"provider": "GitHub",
					"config": {
						"file": ".github/workflows/check-pr.yml",
						"path": "$.jobs.java-style-check"
					},
					"checks": [
						{
							"name": "code style and linting"
						}
					]
				},
				{
					"phase": "pre-merge",
					"provider": "GitHub",
					"config": {
						"file": ".github/workflows/check-pr.yml",
						"path": "$.jobs.unit-tests"
					},
					"checks": [
						{
							"name": "unit"
						}
					]
				},
				{
					"phase": "pre-merge",
					"provider": "GitHub",
					"config": {
						"file": ".github/workflows/check-pr.yml",
						"path": "$.jobs.sonar-scan"
					},
					"checks": [
						{
							"name": "code style and linting"
						},
						{
							"name": "unit test coverage"
						},
						{
							"name": "vulnerability detection"
						}
					]
				},
				{
					"phase": "pre-merge",
					"provider": "GitHub",
					"config": {
						"file": ".github/workflows/check-pr.yml",
						"path": "$.jobs.pact-tests"
					},
					"checks": [
						{
							"name": "contract"
						}
					]
				},
				{
					"phase": "pre-merge",
					"provider": "GitHub",
					"config": {
						"file": ".github/workflows/check-pr.yml",
						"path": "$.jobs.infra-tests"
					},
					"checks": [
						{
							"name": "integration",
							"scope": "component"
						}
					]
				},
				{
					"phase": "pre-merge",
					"provider": "GitHub",
					"config": {
						"file": ".github/workflows/check-pr.yml",
						"path": "$.jobs.pre-merge-integration-tests"
					},
					"checks": [
						{
							"name": "integration",
							"purpose": [
								"regression"
							],
							"scope": "component"
						},
						{
							"name": "integration",
							"scope": "component",
							"purpose": [
								"regression"
							]
						}
					]
				},
				{
					"phase": "pre-merge",
					"provider": "GitHub",
					"config": {
						"file": ".github/workflows/smoke-test-build.yml",
						"path": "$.jobs.smoke"
					},
					"checks": [
						{
							"name": "integration",
							"purpose": [
								"regression",
								"smoke"
							]
						}
					]
				}
			]
		}
	]
}
