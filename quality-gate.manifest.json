{
	"$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.13.0/schemas/schema.json",
	"services": [
		{
			"product": "Passport-CRI",
			"component": "ipv-cri-uk-passport-api",
			"promotionType": "securePipelines",
			"checks": [
				{
					"checkTypes": [
						"code style and linting",
						"secret scanning"
					],
					"phase": "pre-merge",
					"provider": "GitHub",
					"config": {
						"file": ".github/workflows/check-pr.yml",
						"path": "$.jobs.pre-commit"
					}
				},
				{
					"checkTypes": [
						"code style and linting"
					],
					"phase": "pre-merge",
					"provider": "GitHub",
					"config": {
						"file": ".github/workflows/check-pr.yml",
						"path": "$.jobs.java-build-check"
					}
				},
				{
					"checkTypes": [
						"code style and linting"
					],
					"phase": "pre-merge",
					"provider": "GitHub",
					"config": {
						"file": ".github/workflows/check-pr.yml",
						"path": "$.jobs.java-style-check"
					}
				},
				{
					"checkTypes": [
						"unit"
					],
					"phase": "pre-merge",
					"provider": "GitHub",
					"config": {
						"file": ".github/workflows/check-pr.yml",
						"path": "$.jobs.unit-tests"
					}
				},
				{
					"checkTypes": [
						"code style and linting",
						"unit test coverage",
						"vulnerability detection"
					],
					"phase": "pre-merge",
					"provider": "GitHub",
					"config": {
						"file": ".github/workflows/check-pr.yml",
						"path": "$.jobs.sonar-scan"
					}
				},
				{
					"checkTypes": [
						"contract"
					],
					"phase": "pre-merge",
					"provider": "GitHub",
					"config": {
						"file": ".github/workflows/check-pr.yml",
						"path": "$.jobs.pact-tests"
					}
				},
				{
					"checkTypes": [
						"stack"
					],
					"phase": "pre-merge",
					"provider": "GitHub",
					"config": {
						"file": ".github/workflows/check-pr.yml",
						"path": "$.jobs.infra-tests"
					}
				},
				{
					"checkTypes": [
						"component",
						"integration",
						"regression",
						"stack"
					],
					"phase": "pre-merge",
					"provider": "GitHub",
					"config": {
						"file": ".github/workflows/check-pr.yml",
						"path": "$.jobs.pre-merge-integration-tests"
					}
				},
				{
					"checkTypes": [
						"regression",
						"smoke"
					],
					"phase": "pre-merge",
					"provider": "GitHub",
					"config": {
						"file": ".github/workflows/smoke-test-build.yml",
						"path": "$.jobs.smoke"
					}
				}
			]
		}
	]
}
